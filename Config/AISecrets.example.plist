<?xml version="1.0" encoding="UTF-8"?>
<!--
  Шаблон файла с ключом доступа к модели.

  Скопировать в Linea/Resources/AISecrets.plist и вписать ключ:
      mkdir -p Linea/Resources
      cp Config/AISecrets.example.plist Linea/Resources/AISecrets.plist

  Linea/Resources/AISecrets.plist в .gitignore и в репозиторий не попадает.
  Подробности и ограничения — Docs/secrets.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LINEA_AI_API_KEY</key>
    <string></string>

    <!-- Необязательные. Без них берутся значения по умолчанию: xAI Grok. -->
    <key>LINEA_AI_BASE_URL</key>
    <string>https://api.x.ai/v1</string>
    <key>LINEA_AI_MODEL</key>
    <string>grok-4.6</string>
    <!-- chat/completions — совместимый с OpenAI; responses — новый у xAI. -->
    <key>LINEA_AI_PATH</key>
    <string>chat/completions</string>
</dict>
</plist>
